# ==============================================================================
# ChangeLens Configuration Environment Variables
# ==============================================================================
# Copy this file to .env and configure your preferred LLM provider.
# NEVER commit your actual .env file with secrets into version control.

# LLM Provider Options: "gemini" | "groq" | "openai" | "custom"
LLM_PROVIDER=gemini

# Primary API Key (Can also use provider-specific variables below)
LLM_API_KEY=

# Provider-Specific API Keys (Optional overrides)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# LLM Model Name
# Gemini examples: "gemini-2.5-flash", "gemini-1.5-flash", "gemini-1.5-pro"
# Groq examples: "llama-3.3-70b-versatile", "llama-3.1-8b-instant", "deepseek-r1-distill-llama-70b"
# OpenAI examples: "gpt-4o-mini", "gpt-4o"
LLM_MODEL=gemini-2.5-flash
FAST_MODEL=gemini-2.5-flash

# Optional Custom LLM Base URL (for vLLM, Ollama, OpenRouter, etc.)
LLM_BASE_URL=

# GitHub Token (Optional: elevates GitHub REST API rate limits and enables private repos)
GITHUB_TOKEN=

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./changelens.db
WORKSPACE_TEMP_DIR=./temp_workspaces

# Limits & Operational Guardrails
MAX_REPO_SIZE_MB=500
MAX_DIFF_LINES=8000
LLM_TIMEOUT_SECONDS=35.0
ALLOW_OFFLINE_FALLBACK=false

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
